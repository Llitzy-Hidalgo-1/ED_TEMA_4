
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0"
      prefWidth="850.0" prefHeight="600.0"
      style="-fx-background-color: linear-gradient(to bottom right, #10172A, #263B65);"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.litzysystems.menuarboles.controller.MainController">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <Label text="ESTRUCTURAS DE ÁRBOLES"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <Label text="Explora, inserta y visualiza cada estructura"
           style="-fx-font-size: 14px; -fx-text-fill: #C7D2FE;"/>

    <Button text="ÁRBOL BINARIO"
            onAction="#openBinaryTree"
            maxWidth="360"
            prefHeight="42"
            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12;"/>

    <Button text="ÁRBOL BINARIO DE BÚSQUEDA"
            onAction="#openBinarySearchTree"
            maxWidth="360"
            prefHeight="42"
            style="-fx-background-color: #0891B2; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12;"/>

    <Button text="ÁRBOL AVL"
            onAction="#openAVLTree"
            maxWidth="360"
            prefHeight="42"
            style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12;"/>

    <Button text="ÁRBOL GENERAL"
            onAction="#openGeneralTree"
            maxWidth="360"
            prefHeight="42"
            style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12;"/>

    <Button text="RECORRIDOS DE ÁRBOLES"
            onAction="#openTraversalTree"
            maxWidth="360"
            prefHeight="42"
            style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12;"/>

    <Button text="SALIR"
            onAction="#exitApplication"
            maxWidth="180"
            prefHeight="38"
            style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 12;"/>

</VBox>
