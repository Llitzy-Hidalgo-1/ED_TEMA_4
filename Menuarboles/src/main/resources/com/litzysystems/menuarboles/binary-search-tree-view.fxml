
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="850.0" prefHeight="600.0"
            style="-fx-background-color: #EFF6FF;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.litzysystems.menuarboles.controller.BinarySearchTreeController">

    <top>
        <VBox spacing="8" style="-fx-background-color: #1D4ED8;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="ÁRBOL BINARIO DE BÚSQUEDA"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Organiza los valores de menor a mayor"
                   style="-fx-font-size: 14px; -fx-text-fill: #DBEAFE;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="20" bottom="10" left="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="inputField"
                           promptText="Ingresa un número"
                           prefWidth="210"
                           onAction="#insertNode"/>

                <Button text="INSERTAR"
                        onAction="#insertNode"
                        style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="BUSCAR"
                        onAction="#searchNode"
                        style="-fx-background-color: #0891B2; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="LIMPIAR"
                        onAction="#clearTree"
                        style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="MENÚ"
                        onAction="#backToMenu"
                        style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   text="Ingresa un valor para comenzar."
                   style="-fx-font-size: 13px; -fx-text-fill: #1E40AF;"/>

            <Label text="Estructura del árbol"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;"/>

            <ScrollPane fitToWidth="true" fitToHeight="true"
                        prefHeight="310"
                        style="-fx-background-color: white;">
                <Pane fx:id="treePane"
                      minWidth="760"
                      minHeight="300"
                      style="-fx-background-color: white;"/>
            </ScrollPane>

            <Label text="Re corridor en order"
                   style="-fx-font-weight: bold; -fx-text-fill: #1E40AF;"/>

            <TextArea fx:id="outputArea"
                      editable="false"
                      wrapText="true"
                      prefRowCount="3"
                      promptText="Los resultants apparent aqua..."/>
        </VBox>
    </center>

</BorderPane>
