
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="850.0" prefHeight="600.0"
            style="-fx-background-color: #FAF5FF;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.litzysystems.menuarboles.controller.GeneralTreeController">

    <top>
        <VBox spacing="8" style="-fx-background-color: #6D28D9;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="ÁRBOL GENERAL"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Un nodo puede tener varios hijos"
                   style="-fx-font-size: 14px; -fx-text-fill: #EDE9FE;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="20" bottom="12" left="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="inputField"
                           promptText="Nombre del nuevo hijo"
                           prefWidth="240"
                           onAction="#addChild"/>

                <Button text="AGREGAR HIJO"
                        onAction="#addChild"
                        style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="EJEMPLO"
                        onAction="#loadExample"
                        style="-fx-background-color: #0891B2; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="LIMPIAR"
                        onAction="#clearTree"
                        style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="MENÚ"
                        onAction="#backToMenu"
                        style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   text="Árbol general listo."
                   style="-fx-font-size: 13px; -fx-text-fill: #6D28D9;"/>

            <Label text="Representación gráfica"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6D28D9;"/>

            <ScrollPane fitToWidth="true" fitToHeight="true"
                        prefHeight="310"
                        style="-fx-background-color: white;">
                <content>
                    <Pane fx:id="treePane"
                          minWidth="760"
                          minHeight="300"
                          style="-fx-background-color: white;"/>
                </content>
            </ScrollPane>

            <TextArea fx:id="outputArea"
                      editable="false"
                      wrapText="true"
                      prefRowCount="3"
                      promptText="Aquí aparecerá la estructura del árbol..."/>
        </VBox>
    </center>

</BorderPane>
