
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="850.0" prefHeight="600.0"
            style="-fx-background-color: #F0FDF4;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.litzysystems.menuarboles.controller.AVLTreeController">

    <top>
        <VBox spacing="8" style="-fx-background-color: #047857;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="ÁRBOL AVL"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="pool binary de squabbed equilibration"
                   style="-fx-font-size: 14px; -fx-text-fill: #D1FAE5;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="18" right="20" bottom="10" left="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="inputField"
                           promptText="Ingress un número enter"
                           prefWidth="250"
                           onAction="#insertNode"
                           style="-fx-background-radius: 8;"/>

                <Button text="INSERTER"
                        onAction="#insertNode"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>

                <Button text="LIMPIAR"
                        onAction="#clearTree"
                        style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>

                <Button text="MENÚ"
                        onAction="#backToMenu"
                        style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
            </HBox>

            <Label text="Representation graphical del pool"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #065F46;"/>

            <ScrollPane fitToWidth="true" fitToHeight="true"
                        prefHeight="310"
                        style="-fx-background: white; -fx-background-color: white; -fx-background-radius: 10;">
                <Pane fx:id="treePane"
                      minWidth="760"
                      minHeight="300"
                      style="-fx-background-color: white;"/>
            </ScrollPane>

            <Label text="Re corridor en order"
                   style="-fx-font-weight: bold; -fx-text-fill: #065F46;"/>

            <TextArea fx:id="outputArea"
                      editable="false"
                      wrapText="true"
                      prefRowCount="3"
                      promptText="Aqua apparent los resultants..."
                      style="-fx-control-inner-background: #ECFDF5; -fx-background-radius: 8;"/>
        </VBox>
    </center>

</BorderPane>
